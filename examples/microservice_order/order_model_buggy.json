{
  "name": "negative-control-missing-payment-guard",
  "variables": {"paid": [false, true], "shipped": [false, true]},
  "initial": {"paid": false, "shipped": false},
  "transitions": [
    {"id": "pay", "guard": {"paid": false, "shipped": false}, "set": {"paid": true}},
    {"id": "ship", "guard": {"shipped": false}, "set": {"shipped": true}}
  ],
  "invariants": [
    {"id": "shipping_requires_payment", "requirement": "REQ-ORDER-001",
     "when": {"shipped": true}, "assert": {"paid": true}}
  ],
  "terminals": [{"paid": true, "shipped": true}]
}
